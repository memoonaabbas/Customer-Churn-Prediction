     "shell.execute_reply": "2026-07-23T07:59:14.128249Z"
    }
   },
   "outputs": [],
   "source": [
    "# Replace blank spaces with NaN\n",
    "\n",
    "df['TotalCharges'] = df['TotalCharges'].replace(\" \", np.nan)"
