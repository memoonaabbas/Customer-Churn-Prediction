   "source": [
    "from sklearn.linear_model import LogisticRegression\n",
    "\n",
    "# Retrain Logistic Regression with balanced class weights\n",
    "lr_balanced = LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced')\n",
    "lr_balanced.fit(X_train, y_train)\n",
    "\n",
    "y_pred_lr_bal = lr_balanced.predict(X_test)\n",
    "lr_bal_accuracy = accuracy_score(y_test, y_pred_lr_bal)\n",
    "lr_bal_roc = roc_auc_score(y_test, lr_balanced.predict_proba(X_test)[:, 1])\n",
    "\n",
    "print(\"Logistic Regression (class_weight='balanced')\")\n",
    "print(\"Accuracy:\", round(lr_bal_accuracy * 100, 2), \"%\")\n",
    "print(\"ROC-AUC :\", round(lr_bal_roc, 3))\n",
    "print()\n",
    "print(classification_report(y_test, y_pred_lr_bal))"
   ]
