   "source": [
    "from sklearn.metrics import roc_auc_score\n",
    "\n",
    "dt_prob = dt_model.predict_proba(X_test)[:, 1]\n",
    "\n",
    "dt_roc = roc_auc_score(y_test, dt_prob)\n",
    "\n",
    "print(\"Decision Tree ROC-AUC Score:\", round(dt_roc, 3))\n"
   ]
